# ─── Base de datos ──────────────────────────────────────────────
DATABASE_URL=postgres://usuario:password@localhost:5432/lgm

# ─── Sesiones / auth ────────────────────────────────────────────
SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# COOKIE_SECURE=true   # forzar cookies seguras (producción con HTTPS)

# Admin inicial (lo crea el seed de migración)
ADMIN_EMAIL=admin@logmetal.com.ar
ADMIN_PASSWORD=cambiar-esto

# ─── URL pública de la app (para links de los mails) ────────────
APP_URL=https://cotizador.logmetal.com.ar

# ─── IA (extracción de documentos/planos y transcripción) ───────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=            # sólo para transcripción de audios de WhatsApp
GEOCODING_API_KEY=         # cálculo de distancia a obra por dirección

# ─── Notificaciones por email (Resend) ──────────────────────────
# Si RESEND_API_KEY está vacío, los envíos se registran en consola y NO se
# envían (el flujo del negocio no se interrumpe).
RESEND_API_KEY=
EMAIL_FROM=LOG METAL <no-reply@logmetal.com.ar>
# Emails del equipo comercial que reciben los avisos internos (separados por coma)
EQUIPO_COMERCIAL_EMAILS=comercial@logmetal.com.ar
