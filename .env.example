# ─── Base de datos ──────────────────────────────────────────────
# Password del Postgres del docker-compose (obligatoria).
# Puede tener cualquier caracter especial (@, /, #, etc.): el compose la pasa
# como PGPASSWORD, no dentro de una URL.
POSTGRES_PASSWORD=cambiar-por-una-password-segura

# Para desarrollo local sin Docker, usar variables PG* (recomendado) ...
# PGHOST=localhost
# PGPORT=5432
# PGUSER=lgm
# PGPASSWORD=lgm
# PGDATABASE=cotizador
# ... o una DATABASE_URL (solo si la password no tiene caracteres especiales):
# DATABASE_URL=postgres://lgm:lgm@localhost:5432/cotizador

# ─── Bootstrap (usuario maestro) ────────────────────────────────
# En CADA arranque se garantiza que exista este admin maestro (si falta, se
# crea; si ya existe, no se toca su contraseña). Default: admin@logmetal.com.ar
ADMIN_EMAIL=admin@logmetal.com.ar
ADMIN_PASSWORD=L4gm2t1l_2026
# Poner en true por única vez para resetear la contraseña del admin si te
# quedaste afuera; volver a false luego.
# ADMIN_FORCE_RESET=false

# ─── Cookies de sesión ──────────────────────────────────────────
# Dejar sin definir para autodetectar HTTPS (X-Forwarded-Proto).
# Si servís por HTTP plano, la cookie NO debe ser Secure o la sesión no
# persiste: forzar false. Poner true solo cuando tengas HTTPS.
COOKIE_SECURE=false
# Tipo de cambio inicial para el seed del catálogo (opcional)
# TIPO_CAMBIO_INICIAL=1050
# Ubicación base (taller/depósito) usada para calcular la distancia a obra
# del flete. También se puede editar en Configuración → Parámetros.
# UBICACION_BASE=Av. San Martín 1234, Godoy Cruz, Mendoza

# ─── Integraciones ──────────────────────────────────────────────
# Extracción de variables (texto/WhatsApp) y lectura de planos: usa Claude.
# OBLIGATORIA para que funcionen las herramientas de conversión por canal.
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de Claude a usar (opcional, por defecto claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8
# OpenAI: SOLO se usa para transcribir audios de WhatsApp (Whisper), ya que
# Claude no transcribe audio. Si no la definís, el canal de texto/planos sigue
# funcionando con Claude y el de audio pide enviar el mensaje como texto.
# OPENAI_API_KEY=sk-...
# Cálculo automático de distancia a obra (logística):
# - Sin key: usa OpenStreetMap (Nominatim + OSRM), requiere salida a internet.
# - Con key de Google (Distance Matrix): más preciso, acepta direcciones libres.
# GEOCODING_API_KEY=
# FLEXXUS_API_URL=
# FLEXXUS_API_KEY=
# Exportación a Flexxus (CSV): código de cliente por defecto y base del
# correlativo de proyecto. También editables en Configuración → Parámetros.
# CODIGO_CLIENTE_FLEXXUS=00149
# FLEXXUS_PROYECTO_BASE=100
