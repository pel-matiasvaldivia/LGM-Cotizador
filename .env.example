# ─── Base de datos ──────────────────────────────────────────────
# Password del Postgres del docker-compose (obligatoria).
# Puede tener cualquier caracter especial (@, /, #, etc.): el compose la pasa
# como PGPASSWORD, no dentro de una URL.
POSTGRES_PASSWORD=cambiar-por-una-password-segura

# Para desarrollo local sin Docker, usar variables PG* (recomendado) ...
# PGHOST=localhost
# PGPORT=5432
# PGUSER=lgm
# PGPASSWORD=lgm
# PGDATABASE=cotizador
# ... o una DATABASE_URL (solo si la password no tiene caracteres especiales):
# DATABASE_URL=postgres://lgm:lgm@localhost:5432/cotizador

# ─── Bootstrap (usuario maestro) ────────────────────────────────
# En CADA arranque se garantiza que exista este admin maestro (si falta, se
# crea; si ya existe, no se toca su contraseña). Default: admin@logmetal.com.ar
ADMIN_EMAIL=admin@logmetal.com.ar
ADMIN_PASSWORD=L4gm2t1l_2026
# Poner en true por única vez para resetear la contraseña del admin si te
# quedaste afuera; volver a false luego.
# ADMIN_FORCE_RESET=false

# ─── Cookies de sesión ──────────────────────────────────────────
# Dejar sin definir para autodetectar HTTPS (X-Forwarded-Proto).
# Si servís por HTTP plano, la cookie NO debe ser Secure o la sesión no
# persiste: forzar false. Poner true solo cuando tengas HTTPS.
COOKIE_SECURE=false
# Tipo de cambio inicial para el seed del catálogo (opcional)
# TIPO_CAMBIO_INICIAL=1050
# Ubicación base (taller/depósito) usada para calcular la distancia a obra
# del flete. También se puede editar en Configuración → Parámetros.
# UBICACION_BASE=Av. San Martín 1234, Godoy Cruz, Mendoza

# ─── Integraciones ──────────────────────────────────────────────
# Extracción de variables (texto/WhatsApp) y lectura de planos: usa Claude.
# OBLIGATORIA para que funcionen las herramientas de conversión por canal.
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de Claude a usar (opcional, por defecto claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8
# OpenAI: SOLO se usa para transcribir audios de WhatsApp (Whisper), ya que
# Claude no transcribe audio. Si no la definís, el canal de texto/planos sigue
# funcionando con Claude y el de audio pide enviar el mensaje como texto.
# OPENAI_API_KEY=sk-...
# Cálculo automático de distancia a obra (logística):
# - Sin key: usa OpenStreetMap (Nominatim + OSRM), requiere salida a internet.
# - Con key de Google (Distance Matrix): más preciso, acepta direcciones libres.
# GEOCODING_API_KEY=
# FLEXXUS_API_URL=
# FLEXXUS_API_KEY=
# Exportación a Flexxus (CSV): código de cliente por defecto y base del
# correlativo de proyecto. También editables en Configuración → Parámetros.
# CODIGO_CLIENTE_FLEXXUS=00149
# FLEXXUS_PROYECTO_BASE=100

# ─── Versión desplegada ─────────────────────────────────────────
# Tag de la imagen de GHCR. Por defecto `main` (lo último liberado). Para
# quedarse en una versión puntual: IMAGE_TAG=sha-abc1234
# IMAGE_TAG=main

# ─── Multi-tenant / marca blanca ────────────────────────────────
# Cada empresa es un tenant y se resuelve por el dominio del request. Su
# identidad y sus datos fiscales viven en la BASE (Configuración → Empresa);
# lo de acá abajo son los VALORES INICIALES del primer arranque.
#
# Dominios de la empresa de este despliegue (coma-separados). El bootstrap del
# arranque los asigna; después se administran con scripts/tenant.mjs.
TENANT_DOMINIOS=logmetal.com.ar
# Fuerza una empresa concreta cuando el Host no matchea ningún dominio (útil en
# desarrollo y detrás de proxies que no reenvían el Host).
# TENANT_DEFAULT=logmetal
#
# Preset de valores iniciales: lee motor-presupuestacion/config/brands/<BRAND>.json
# Sin definir, la empresa arranca neutra ("Mi Empresa") y se completa del panel.
BRAND=logmetal
# Config completa fuera del repo (pisa al preset). Ideal para montar por volumen.
# BRAND_CONFIG_FILE=/app/config/tenant/marca.json
# Carpeta alternativa de presets (por defecto <app>/config/brands).
# BRAND_CONFIG_DIR=/app/config/tenant

# Overrides puntuales: pisan lo del preset y del BRAND_CONFIG_FILE. Alcanzan
# para levantar un tenant nuevo sin tocar ningún archivo JSON.
# BRAND_NOMBRE=Acero Sur
# BRAND_RAZON_SOCIAL=Acero Sur S.A.
# BRAND_TAGLINE=NAVES INDUSTRIALES
# Colores en hex (#rgb, #rrggbb o #rrggbbaa). Solo hacen falta estos tres: los
# tonos de hover, fondos suaves y bordes se derivan por CSS.
# BRAND_COLOR_PRIMARY=#0e9f6e   # acento: botones, links, destacados
# BRAND_COLOR_INK=#12263f       # institucional: títulos y secciones oscuras
# BRAND_COLOR_SURFACE=#f5f7f6   # gris de fondo de las secciones alternadas
# Logo: ruta pública (recomendado /brand/... montado por volumen) o URL https.
# Sin logo, se usa el nombre de la empresa como wordmark tipográfico.
# BRAND_LOGO=/brand/acero-sur.svg
# BRAND_LOGO_OSCURO=/brand/acero-sur-blanco.svg
# BRAND_LOGO_ALTO=44
# BRAND_DIRECCION=Parque Industrial Oeste, Neuquén, Argentina
# BRAND_TELEFONO=+54 9 299 123-4567
# BRAND_EMAIL=ventas@acerosur.example
# BRAND_WHATSAPP=5492991234567   # sin + ni espacios; vacío oculta el botón
# BRAND_FOOTER_NOTA=Neuquén, Argentina
# BRAND_META_TITLE=Acero Sur — Estructuras metálicas
# BRAND_META_DESCRIPTION=Ingeniería, fabricación y montaje de naves industriales.
# Datos que salen impresos en el presupuesto (después se editan desde el panel).
# BRAND_CUIT=30-71234567-4
# BRAND_CONDICION_IVA=Responsable Inscripto
# BRAND_INGRESOS_BRUTOS=Convenio Multilateral 901-123456-7
# BRAND_INICIO_ACTIVIDADES=01/03/1998
# BRAND_DOMICILIO=Parque Industrial Oeste 450
# BRAND_LOCALIDAD=Neuquén
# BRAND_PROVINCIA=Neuquén
# BRAND_CODIGO_POSTAL=Q8300
# BRAND_WEB=www.acerosur.example
