# ─── Base de datos ──────────────────────────────────────────────
# Password del Postgres del docker-compose (obligatoria)
POSTGRES_PASSWORD=cambiar-por-una-password-segura

# Para desarrollo local sin Docker:
# DATABASE_URL=postgres://lgm:lgm@localhost:5432/cotizador

# ─── Bootstrap (primer arranque) ────────────────────────────────
# Si la tabla de usuarios está vacía, se crea este admin al migrar
ADMIN_EMAIL=admin@logmetal.com
ADMIN_PASSWORD=cambiar-por-una-password-segura
# Tipo de cambio inicial para el seed del catálogo (opcional)
# TIPO_CAMBIO_INICIAL=1050

# ─── Integraciones ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# FLEXXUS_API_URL=
# FLEXXUS_API_KEY=
